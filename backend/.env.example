# Server
NODE_ENV=development
PORT=5001

# Comma-separated list of allowed frontend origins (no trailing slash)
# e.g. "https://heroy.dev,https://www.heroy.dev"
FRONTEND_URL=http://localhost:3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<database>

# Anthropic API key — only needed if you re-enable server-side AI features.
# The live chat widget currently calls the Next.js API route directly and
# does not use this backend, so this can be left blank unless you rewire it.
ANTHROPIC_API_KEY=

# Shared secret required in the "x-admin-key" header to access admin-only
# endpoints (listing contacts, consultations, subscribers; changing status).
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# Outgoing email (SMTP) — used for contact form notifications,
# consultation booking confirmations, and newsletter confirmations.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="HEROY Digital Solutions <your-email@example.com>"
EMAIL_TO=your-team-inbox@example.com